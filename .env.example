# Your One API key. Run `one init` (https://www.withone.ai/docs) or copy it
# from your One dashboard.
ONE_API_KEY=

# The key of your Stripe connection on One. Run `one list` to see your
# connections, or connect Stripe first with `one add stripe`.
ONE_CONNECTION_STRIPE=

# Optional: the product name in the nav and the page title (default Tally).
PRODUCT_NAME=Tally

# Optional: which Stripe products appear, as comma-separated ids, in the order
# you want them. Leave empty to show products tagged pricing_page=true in their
# Stripe metadata, or every active product with a recurring price.
PRICING_PRODUCTS=

# Optional: only prices in this currency are shown (default usd).
CURRENCY=usd

# Optional: seconds a Stripe read is reused before the page reads again (default 60).
CACHE_SECONDS=60

# Optional: where the free plan's button and "Sign in" go.
SIGNUP_URL=

# Optional: where the "Talk to sales" button goes, e.g. a Calendly link.
SALES_URL=

# Optional: this site's public URL, for Stripe's success and cancel redirects.
# Defaults to the host the request came in on.
SITE_URL=
